    <select id="selectMyArticleList" resultMap="articleVoListMap">
        SELECT
            a.ID, a.TITLE, a.SUMMARY, a.ARTICLE_TYPE, a.ARTICLE_PERM, a.ARTICLE_STATUS,
            a.COMMENT_FLAG, a.WORDS_COUNT, a.VIEW_COUNT, a.COMMENT_COUNT, a.AUTHOR_ID,
            a.UPDATE_TIME, a.VERSION, a.DELETE_FLAG, a.COVER_IMAGE_TYPE,
            u.NICKNAME AS AUTHOR_NAME, c.NAME AS CATEGORY_NAME
        FROM article a
        LEFT JOIN category c ON c.ID = a.CATEGORY_ID
        LEFT JOIN user u ON u.ID = a.AUTHOR_ID
        WHERE a.AUTHOR_ID = #{query.authorId}
        <choose>
            <!-- 1: 全部 -->
            <when test='query.tagStatus == "1"'>
                AND a.DELETE_FLAG = 0
            </when>
            <!-- 2: 草稿 -->
            <when test='query.tagStatus == "2"'>
                AND a.DELETE_FLAG = 0 AND a.ARTICLE_STATUS = 1
            </when>
            <!-- 3: 私密 -->
            <when test='query.tagStatus == "3"'>
                AND a.DELETE_FLAG = 0 AND a.ARTICLE_PERM = 3
            </when>
            <!-- 4: 已发布（不包含私密文章） -->
            <when test='query.tagStatus == "4"'>
                AND a.DELETE_FLAG = 0 AND a.ARTICLE_STATUS = 5 AND a.ARTICLE_PERM != 3
            </when>
            <!-- 5: 待审核 -->
            <when test='query.tagStatus == "5"'>
                AND a.DELETE_FLAG = 0 AND a.ARTICLE_STATUS = 2
            </when>
            <!-- 6: 待发布 -->
            <when test='query.tagStatus == "6"'>
                AND a.DELETE_FLAG = 0 AND a.ARTICLE_STATUS = 3
            </when>
            <!-- 7: 待处理 -->
            <when test='query.tagStatus == "7"'>
                AND a.DELETE_FLAG = 0 AND a.ARTICLE_STATUS IN (4, 91)
            </when>
            <!-- 8: 回收站 -->
            <when test='query.tagStatus == "8"'>
                AND a.DELETE_FLAG = 1
            </when>
            <otherwise>
                <!-- 返回空列表 -->
                AND a.ARTICLE_STATUS = -1
            </otherwise>
        </choose>
        <if test="query.title != null and query.title != ''">
            <bind name="titleBind" value="'%' + query.title + '%'"/>
            AND a.TITLE LIKE #{titleBind}
        </if>
        <if test="query.slug != null and query.slug != ''">
            AND a.SLUG = #{query.slug}
        </if>
        <if test="query.categoryId != null">
            AND a.CATEGORY_ID = #{query.categoryId}
        </if>
        <if test="query.tagId != null">
            AND a.ID IN (SELECT ARTICLE_ID FROM article_tag_relation atr WHERE atr.TAG_ID = #{query.tagId})
        </if>
        <if test="query.articleType != null">
            AND a.ARTICLE_TYPE = #{query.articleType}
        </if>
        <if test="query.articleStatus != null">
            AND a.ARTICLE_STATUS = #{query.articleStatus}
        </if>
        <if test="query.commentFlag != null">
            AND a.COMMENT_FLAG = #{query.commentFlag}
        </if>
        ORDER BY a.UPDATE_TIME DESC
    </select>

    <select id="selectArticleTagNamesByArticleIds" resultType="com.github.stazxr.zblog.content.domain.vo.ArticleTagNameVo">
        SELECT
            atr.ARTICLE_ID AS articleId, t.NAME AS tagName
        FROM article_tag_relation atr
        INNER JOIN tag t ON t.ID = atr.TAG_ID
        WHERE atr.DELETED = 0 AND atr.ARTICLE_ID IN
        <foreach collection="articleIds" item="articleId" open="(" separator="," close=")">
            #{articleId}
        </foreach>
        ORDER BY atr.ARTICLE_ID, atr.TAG_ID
    </select>

    <select id="selectArticleCoverImagesByArticleIds" resultType="com.github.stazxr.zblog.content.domain.vo.ArticleCoverImageVo">
        SELECT
            air.ARTICLE_ID AS articleId, air.ARTICLE_IMAGE AS coverImage
        FROM article_image_relation air
        WHERE air.ARTICLE_ID IN
        <foreach collection="articleIds" item="articleId" open="(" separator="," close=")">
            #{articleId}
        </foreach>
        ORDER BY air.ARTICLE_ID, air.ARTICLE_IMAGE
    </select>

    <select id="selectMyArticleCountInfo" resultType="com.github.stazxr.zblog.content.domain.vo.ArticleCountVo">
        SELECT
            SUM(a.DELETE_FLAG = 0) AS totalCount,
            SUM(a.DELETE_FLAG = 0 AND a.ARTICLE_STATUS = 1) AS draftCount,
            SUM(a.DELETE_FLAG = 0 AND a.ARTICLE_PERM = 3) AS privateCount,
            SUM(a.DELETE_FLAG = 0 AND a.ARTICLE_STATUS = 5 AND a.ARTICLE_PERM != 3) AS publicCount,
            SUM(a.DELETE_FLAG = 0 AND a.ARTICLE_STATUS = 2) AS pendingAuditCount,
            SUM(a.DELETE_FLAG = 0 AND a.ARTICLE_STATUS = 3) AS pendingPublishCount,
            SUM(a.DELETE_FLAG = 0 AND a.ARTICLE_STATUS IN (4, 91)) AS pendingDealCount,
            SUM(a.DELETE_FLAG = 1) AS recycleCount
        FROM article a
        WHERE AUTHOR_ID = #{authorId} AND a.DELETE_FLAG != 2
    </select>

    <select id="selectArticleDetail" resultType="com.github.stazxr.zblog.content.domain.vo.ArticleVo">
        SELECT
            a.ID, a.TITLE, a.SLUG, a.SUMMARY, a.CONTENT_MD, a.CONTENT_HTML, a.CATEGORY_ID, c.NAME AS CATEGORY_NAME,
            a.AUTHOR_ID, u.NICKNAME AS AUTHOR_NAME, a.SEO_TITLE, a.SEO_KEYWORDS, a.SEO_DESCRIPTION,
            a.ARTICLE_TYPE, a.ARTICLE_STATUS, a.DELETE_FLAG, a.ARTICLE_PERM, a.SOURCE_NAME, a.SOURCE_AUTHOR, a.SOURCE_URL,
            a.COMMENT_FLAG, a.COVER_IMAGE_TYPE, a.WORDS_COUNT, a.VIEW_COUNT, a.LIKE_COUNT, a.COMMENT_COUNT, a.FAVORITE_COUNT,
            a.PUBLISH_TIME, a.CREATE_TIME, a.UPDATE_TIME, a.DELETE_TIME, a.VERSION, a.EXTRA_INFO
        FROM article a
        LEFT JOIN category c ON c.ID = a.CATEGORY_ID
        LEFT JOIN user u ON u.ID = a.AUTHOR_ID
        WHERE a.DELETE_FLAG != 2 AND a.ID = #{articleId}
    </select>

    <select id="selectLastArticleEmptyDraft" resultType="com.github.stazxr.zblog.content.domain.vo.ArticleVo">
        SELECT
            a.ID, a.TITLE, a.SLUG, a.SUMMARY, a.CONTENT_MD, a.CATEGORY_ID,
            a.SEO_TITLE, a.SEO_KEYWORDS, a.SEO_DESCRIPTION,
            a.ARTICLE_TYPE, a.ARTICLE_STATUS, a.ARTICLE_PERM, a.SOURCE_NAME, a.SOURCE_AUTHOR, a.SOURCE_URL,
            a.COMMENT_FLAG, a.COVER_IMAGE_TYPE, a.WORDS_COUNT, a.VIEW_COUNT, a.LIKE_COUNT, a.COMMENT_COUNT, a.FAVORITE_COUNT,
            a.PUBLISH_TIME, a.CREATE_TIME, a.UPDATE_TIME, a.DELETE_TIME, a.VERSION, a.EXTRA_INFO
        FROM article a
        WHERE
            a.AUTHOR_ID = #{authorId} AND a.ARTICLE_STATUS = 1 AND a.DELETE_FLAG = 0 AND
            a.TITLE = '' AND a.SLUG IS NULL AND a.CONTENT_MD = '' AND a.SUMMARY IS NULL AND
            a.CATEGORY_ID IS NULL AND a.ARTICLE_TYPE = 1 AND a.ARTICLE_PERM = 1 AND a.COVER_IMAGE_TYPE = 1
        ORDER BY a.UPDATE_TIME DESC LIMIT 1
    </select>

    <select id="selectLastArticleDraft" resultType="com.github.stazxr.zblog.content.domain.vo.ArticleVo">
        SELECT ID, TITLE FROM article WHERE AUTHOR_ID = #{authorId} AND ARTICLE_STATUS = 1 ORDER BY UPDATE_TIME DESC LIMIT 1
    </select>

    <update id="updateArticleById">
        UPDATE article SET
            TITLE = #{a.title},
            SLUG = #{a.slug},
            SUMMARY = #{a.summary},
            CONTENT_MD = #{a.contentMd},
            CONTENT_HTML = #{a.contentHtml},
            CATEGORY_ID = #{a.categoryId},
            SEO_TITLE = #{a.seoTitle},
            SEO_KEYWORDS = #{a.seoKeywords},
            SEO_DESCRIPTION = #{a.seoDescription},
            ARTICLE_TYPE = #{a.articleType},
            SOURCE_NAME = #{a.sourceName},
            SOURCE_AUTHOR = #{a.sourceAuthor},
            SOURCE_URL = #{a.sourceUrl},
            COMMENT_FLAG = #{a.commentFlag},
            ARTICLE_PERM = #{a.articlePerm},
            COVER_IMAGE_TYPE = #{a.coverImageType},
            WORDS_COUNT = #{a.wordsCount},
            ARTICLE_STATUS = #{a.articleStatus},
            UPDATER_ID = #{a.updaterId},
            UPDATE_TIME = #{a.updateTime}
        WHERE ID = #{a.id}
    </update>

    <update id="deleteArticle">
        UPDATE article SET DELETE_FLAG = #{deleteType} WHERE ID = #{articleId}
    </update>

    <delete id="deleteArticle3">
        UPDATE article SET DELETE_FLAG = 2 WHERE AUTHOR_ID = #{authorId} AND DELETE_FLAG = 1
    </delete>


